 change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["325"],"no-global-assign","no-unsafe-negation",{"desc":"326","fix":"327"},{"desc":"328","fix":"329"},{"desc":"330","fix":"331"},[0,13],"",{"desc":"332","fix":"333"},{"desc":"334","fix":"335"},{"desc":"336","fix":"337"},{"desc":"338","fix":"339"},"Update the dependencies array to be: [auth.isEmpty, error, history, location.pathname, submitSucceeded]",{"range":"340","text":"341"},"Update the dependencies array to be: [primary, to]",{"range":"342","text":"343"},"Update the dependencies array to be: [navigateToDashboardOnError, params.id, props]",{"range":"344","text":"345"},"Update the dependencies array to be: [currentQuantity.grams, foodItem]",{"range":"346","text":"347"},"Update the dependencies array to be: [maxQuantity, plusDisabledStmt, quantity]",{"range":"348","text":"349"},"Update the dependencies array to be: [quantityStmt, value]",{"range":"350","text":"351"},"Update the dependencies array to be: [debouncedInput, foodItems, props]",{"range":"352","text":"353"},[1566,1592],"[auth.isEmpty, error, history, location.pathname, submitSucceeded]",[559,563],"[primary, to]",[1966,1968],"[navigateToDashboardOnError, params.id, props]",[11789,11801],"[currentQuantity.grams, foodItem]",[15400,15423],"[maxQuantity, plusDisabledStmt, quantity]",[16533,16542],"[quantityStmt, value]",[4462,4480],"[debouncedInput, foodItems, props]"]